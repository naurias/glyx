{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "glyx",
  "version": "0.1.0",
  "identifier": "dev.glyx.app",
  "build": {
    "frontendDist": "../../apps/webui/build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev --dir ../../apps/webui",
    "beforeBuildCommand": "pnpm build --dir ../../apps/webui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png"]
  }
}
